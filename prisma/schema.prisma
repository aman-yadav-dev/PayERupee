// -----------------------------------------------------------------------------
// PRISMA CONFIGURATION
// -----------------------------------------------------------------------------
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------
enum UserRole {
  ADMIN
  MERCHANT
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum Currency {
  INR
}

enum PaymentMode {
  UPI
  IMPS
  NEFT
  RTGS
  WALLET
  CARD
}

enum PayoutProvider {
  MANUAL
  RAZORPAY
  CASHFREE
  PAYTM
  BANK
}

enum Environment {
  TEST
  LIVE
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionCategory {
  FUND_ADD
  PAYOUT
  FEE
  TAX
  REFUND
  ADJUSTMENT
}

enum ReferenceType {
  FUND_REQUEST
  PAYOUT
  SYSTEM
}

enum FundRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum AuditEntity {
  USER
  PAYOUT
  FUND_REQUEST
  API_KEY
  WALLET
  BLACKLIST
  SUPPORT
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  SUSPEND
  RESTORE
  PROCESS
  BAN
  UNBAN
}

enum BlacklistType {
  UPI
  BANK_ACCOUNT
  IFSC
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// -----------------------------------------------------------------------------
// AUTHENTICATION MODELS (BETTER AUTH SCHEMA + FINTECH EXTENSIONS)
// -----------------------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Better Auth Relations
  sessions      Session[]
  accounts      Account[]

  // --- FINTECH EXTENSIONS ---
  businessName  String?     @db.VarChar(150)
  address       String?     
  role          UserRole    @default(MERCHANT)
  status        UserStatus  @default(PENDING)
  phone         String?     @unique @db.VarChar(15) 
  kycApprovedAt DateTime?
  deletedAt     DateTime?   

  // Financial Relations
  wallet              Wallet?
  apiKeys             ApiKey[]            @relation("MerchantApiKeys")
  payouts             Payout[]
  auditLogs           AuditLog[]          @relation("AdminAudits")
  
  // Fund Request Relations
  fundRequests        FundRequest[]       @relation("MerchantFundRequests")
  approvedRequests    FundRequest[]       @relation("AdminFundApprovals")
  createdFundRequests FundRequest[]       @relation("AdminCreatedFundRequests")
  
  // Creation Tracking
  createdApiKeys      ApiKey[]            @relation("AdminCreatedApiKeys")

  // Blacklist & Support Relations
  merchantBlacklists  Blacklist[]         @relation("MerchantBlacklists")
  adminBlacklists     Blacklist[]         @relation("AdminBlacklists")
  supportTickets      SupportTicket[]     @relation("MerchantSupportTickets")
  supportMessages     SupportMessage[]    @relation("UserSupportMessages")
  settingsUpdates     SystemSetting[]     @relation("AdminSettingsUpdates")

  @@index([deletedAt])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@unique([identifier, value])
  @@map("verifications")
}

// -----------------------------------------------------------------------------
// FINTECH CORE MODELS
// -----------------------------------------------------------------------------

model ApiKey {
  id          String      @id @default(cuid())
  merchantId  String
  createdById String?
  environment Environment @default(LIVE)
  name        String      @db.VarChar(50)
  keyPrefix   String      @db.VarChar(50)
  lastFour    String      // Masked display (e.g. A93K)
  keyHash     String      @unique 
  isActive    Boolean     @default(true)
  
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  merchant    User        @relation("MerchantApiKeys", fields: [merchantId], references: [id], onDelete: Restrict)
  createdBy   User?       @relation("AdminCreatedApiKeys", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([merchantId, isActive])
  @@index([deletedAt])
  @@map("api_keys")
}

// Cached balance. 
// Source of truth is always the WalletTransaction ledger.
model Wallet {
  id          String   @id @default(cuid())
  merchantId  String   @unique
  currency    Currency @default(INR)
  balance     Decimal  @default(0.0000) @db.Decimal(18, 4)
  isActive    Boolean  @default(true)
  version     Int      @default(1) // Optimistic locking to prevent race conditions
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant    User     @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]

  @@index([merchantId])
  @@map("wallets")
}

// THE IMMUTABLE LEDGER
model WalletTransaction {
  id                String              @id @default(cuid())
  walletId          String
  type              TransactionType     
  category          TransactionCategory 
  amount            Decimal             @db.Decimal(18, 4)
  fee               Decimal?            @db.Decimal(18, 4)
  tax               Decimal?            @db.Decimal(18, 4)
  balanceAfter      Decimal             @db.Decimal(18, 4) 
  
  referenceType     ReferenceType
  referenceId       String?             // Nullable for manual system adjustments             
  externalReference String?             // UTR, RRN, NPCI Reference, etc.
  description       String              
  
  createdAt         DateTime            @default(now()) // Immutable: No updatedAt

  wallet            Wallet              @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@index([category])
  @@map("wallet_transactions")
}

model FundRequest {
  id              String            @id @default(cuid())
  merchantId      String
  createdById     String?           // Track if an Admin created this on behalf of a merchant
  approvedById    String?
  
  amount          Decimal           @db.Decimal(18, 4)
  status          FundRequestStatus @default(PENDING)
  paymentMode     PaymentMode       @default(UPI)
  utrNumber       String            @unique 
  receiptUrl      String?
  remarks         String?
  rejectionReason String?
  
  processedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  merchant        User              @relation("MerchantFundRequests", fields: [merchantId], references: [id], onDelete: Restrict)
  createdBy       User?             @relation("AdminCreatedFundRequests", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy      User?             @relation("AdminFundApprovals", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([merchantId, status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("fund_requests")
}

model Payout {
  id                  String          @id @default(cuid())
  merchantId          String
  idempotencyKey      String       
  batchId             String?      
  
  amount              Decimal         @db.Decimal(18, 4)
  fee                 Decimal         @default(0.0000) @db.Decimal(18, 4)
  tax                 Decimal         @default(0.0000) @db.Decimal(18, 4)
  netAmount           Decimal         @db.Decimal(18, 4) 
  
  status              PayoutStatus    @default(PENDING)
  paymentMode         PaymentMode     @default(IMPS)
  provider            PayoutProvider? 
  
  // Beneficiary Data (Direct for MVP)
  accountNumber       String          @db.VarChar(30)
  ifscCode            String          @db.VarChar(11)
  accountHolderName   String
  beneficiaryPhone    String?
  
  // References & Notes
  merchantReference   String?         @db.VarChar(100)
  providerReference   String?         // ID returned by upstream provider
  bankReference       String?         @unique 
  notes               String?
  failureReason       String?
  
  processedAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  deletedAt           DateTime?

  merchant            User            @relation(fields: [merchantId], references: [id], onDelete: Restrict)

  @@unique([merchantId, idempotencyKey])
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([merchantId, status])
  @@index([status])
  @@index([batchId])
  @@index([deletedAt])
  @@map("payouts")
}

// -----------------------------------------------------------------------------
// FRAUD, SECURITY & COMPLIANCE
// -----------------------------------------------------------------------------

model Blacklist {
  id          String        @id @default(cuid())
  merchantId  String?       // Null = Global Admin Ban across all merchants
  type        BlacklistType
  value       String        @unique // UPI ID or Account Number
  reason      String?
  addedById   String

  merchant    User?         @relation("MerchantBlacklists", fields: [merchantId], references: [id], onDelete: Cascade)
  addedBy     User          @relation("AdminBlacklists", fields: [addedById], references: [id], onDelete: Restrict)

  createdAt   DateTime      @default(now())

  @@index([type, value])
  @@map("blacklists")
}

model SupportTicket {
  id          String           @id @default(cuid())
  merchantId  String
  subject     String
  status      TicketStatus     @default(OPEN)
  priority    TicketPriority   @default(NORMAL)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  merchant    User             @relation("MerchantSupportTickets", fields: [merchantId], references: [id], onDelete: Cascade)
  messages    SupportMessage[]

  @@index([merchantId, status])
  @@map("support_tickets")
}

model SupportMessage {
  id          String        @id @default(cuid())
  ticketId    String
  senderId    String
  isAdmin     Boolean       @default(false)
  message     String        @db.Text
  createdAt   DateTime      @default(now())

  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User          @relation("UserSupportMessages", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt(sort: Asc)])
  @@map("support_messages")
}

model SystemSetting {
  id                String      @id @default("GLOBAL_SETTINGS")
  upiPayoutFee      Decimal     @default(0.0000) @db.Decimal(18, 4)
  impsPayoutFee     Decimal     @default(0.0000) @db.Decimal(18, 4)
  neftPayoutFee     Decimal     @default(0.0000) @db.Decimal(18, 4)
  rtgsPayoutFee     Decimal     @default(0.0000) @db.Decimal(18, 4)
  taxPercentage     Decimal     @default(0.00) @db.Decimal(5, 2) // e.g. 18.00 for 18% GST
  minPayoutAmount   Decimal     @default(100.0000) @db.Decimal(18, 4)
  maxPayoutAmount   Decimal     @default(500000.0000) @db.Decimal(18, 4)
  updatedAt         DateTime    @updatedAt
  updatedById       String?

  updatedBy         User?       @relation("AdminSettingsUpdates", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model AuditLog {
  id          String      @id @default(cuid())
  adminId     String
  entityType  AuditEntity
  entityId    String   
  action      AuditAction
  ipAddress   String?
  userAgent   String?
  metadata    Json?    
  
  createdAt   DateTime    @default(now())

  admin       User        @relation("AdminAudits", fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}