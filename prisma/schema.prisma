// -----------------------------------------------------------------------------
// PRISMA CONFIGURATION
// -----------------------------------------------------------------------------
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------
enum UserRole {
  ADMIN
  MERCHANT
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum KycStatus {
  PENDING_SUBMISSION
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum Currency {
  INR
}

enum PaymentMode {
  UPI
  IMPS
  NEFT
  RTGS
  WALLET
  CARD
}

enum PayoutProvider {
  MANUAL
  RAZORPAY
  CASHFREE
  PAYTM
  BANK
}

enum Environment {
  TEST
  LIVE
}

enum LedgerAccountType {
  MERCHANT_LIABILITY
  SYSTEM_TRANSIT
  SYSTEM_REVENUE
}

enum LedgerEntryPurpose {
  PRINCIPAL
  FEE_AND_TAX
  REVERSAL_PRINCIPAL
  REVERSAL_FEE_AND_TAX
  MANUAL_ADJUSTMENT
}

enum ReferenceType {
  FUND_REQUEST
  PAYOUT
  SYSTEM
}

enum FundRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum AuditActorType {
  SYSTEM
  ADMIN
  MERCHANT
}

enum AuditEntity {
  USER
  MERCHANT_PROFILE
  KYC_APPLICATION
  PAYOUT
  FUND_REQUEST
  API_KEY
  WALLET
  LEDGER_ACCOUNT
  LEDGER_ENTRY
  BLACKLIST
  SUPPORT
  SYSTEM
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  SUSPEND
  RESTORE
  PROCESS
  BAN
  UNBAN
}

enum BlacklistType {
  UPI
  BANK_ACCOUNT
  IFSC
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// -----------------------------------------------------------------------------
// AUTHENTICATION MODELS (BETTER AUTH 1.6.25 COMPATIBLE)
// -----------------------------------------------------------------------------
model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role UserRole @default(MERCHANT)

  sessions Session[]
  accounts Account[]

  merchantProfile MerchantProfile?

  createdApiKeys      ApiKey[]         @relation("AdminCreatedApiKeys")
  createdFundRequests FundRequest[]    @relation("AdminCreatedFundRequests")
  approvedRequests    FundRequest[]    @relation("AdminFundApprovals")
  adminBlacklists     Blacklist[]      @relation("AdminBlacklists")
  supportMessages     SupportMessage[] @relation("UserSupportMessages")
  settingsUpdates     SystemSetting[]  @relation("AdminSettingsUpdates")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@unique([identifier, value])
  @@map("verifications")
}

// -----------------------------------------------------------------------------
// BUSINESS DOMAIN MODELS
// -----------------------------------------------------------------------------

model MerchantProfile {
  id            String        @id @default(cuid())
  userId        String        @unique
  businessName  String?       @db.VarChar(150)
  address       String?
  phone         String?       @unique @db.VarChar(15)
  accountStatus AccountStatus @default(PENDING)

  kycApprovedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  kycApplication KycApplication?
  wallet         Wallet?
  ledgerAccounts LedgerAccount[]

  apiKeys        ApiKey[]
  payouts        Payout[]
  fundRequests   FundRequest[]
  blacklists     Blacklist[]
  supportTickets SupportTicket[]

  @@index([deletedAt])
  @@map("merchant_profiles")
}

model KycApplication {
  id                String    @id @default(cuid())
  merchantProfileId String    @unique
  documentUrls      Json
  status            KycStatus @default(PENDING_SUBMISSION)

  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  merchantProfile MerchantProfile @relation(fields: [merchantProfileId], references: [id], onDelete: Restrict)

  @@map("kyc_applications")
}

// -----------------------------------------------------------------------------
// DOUBLE-ENTRY LEDGER SYSTEM
// -----------------------------------------------------------------------------

model LedgerAccount {
  id                String            @id @default(cuid())
  merchantProfileId String?
  type              LedgerAccountType
  currency          Currency          @default(INR)
  isActive          Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchantProfile MerchantProfile? @relation(fields: [merchantProfileId], references: [id], onDelete: Restrict)
  wallet          Wallet?

  debitEntries  LedgerEntry[] @relation("DebitAccount")
  creditEntries LedgerEntry[] @relation("CreditAccount")

  @@unique([merchantProfileId, type, currency])
  @@index([type])
  @@map("ledger_accounts")
}

model Wallet {
  id                String   @id @default(cuid())
  merchantProfileId String   @unique
  ledgerAccountId   String   @unique
  currency          Currency @default(INR)
  balance           Decimal  @default(0.0000) @db.Decimal(18, 4)
  isActive          Boolean  @default(true)
  version           Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchantProfile MerchantProfile @relation(fields: [merchantProfileId], references: [id], onDelete: Restrict)
  ledgerAccount   LedgerAccount   @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@map("wallets")
}

model LedgerEntry {
  id     String  @id @default(cuid())
  amount Decimal @db.Decimal(18, 4)

  debitAccountId  String
  creditAccountId String
  payoutId        String?
  purpose         LedgerEntryPurpose

  referenceType ReferenceType
  referenceId   String?
  description   String

  createdAt DateTime @default(now())

  debitAccount  LedgerAccount @relation("DebitAccount", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccount LedgerAccount @relation("CreditAccount", fields: [creditAccountId], references: [id], onDelete: Restrict)
  payout        Payout?       @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@unique([payoutId, purpose])
  @@index([debitAccountId])
  @@index([creditAccountId])
  @@index([referenceType, referenceId])
  @@map("ledger_entries")
}

// -----------------------------------------------------------------------------
// TRANSACTIONS & OPERATIONS
// -----------------------------------------------------------------------------

model Payout {
  id                String  @id @default(cuid())
  merchantProfileId String
  idempotencyKey    String
  batchId           String?

  amount           Decimal @db.Decimal(18, 4)
  fee              Decimal @default(0.0000) @db.Decimal(18, 4)
  tax              Decimal @default(0.0000) @db.Decimal(18, 4)
  totalDebitAmount Decimal @db.Decimal(18, 4)

  status      PayoutStatus    @default(PENDING)
  paymentMode PaymentMode     @default(IMPS)
  provider    PayoutProvider?

  accountNumber     String  @db.VarChar(30)
  ifscCode          String  @db.VarChar(11)
  accountHolderName String
  beneficiaryPhone  String?

  merchantReference String? @db.VarChar(100)
  providerReference String?
  bankReference     String? @unique
  notes             String?
  failureReason     String?

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  merchantProfile MerchantProfile @relation(fields: [merchantProfileId], references: [id], onDelete: Restrict)
  ledgerEntries   LedgerEntry[]

  @@unique([merchantProfileId, idempotencyKey])
  @@index([merchantProfileId, createdAt(sort: Desc)])
  @@index([status])
  @@index([deletedAt])
  @@map("payouts")
}

model FundRequest {
  id                String  @id @default(cuid())
  merchantProfileId String
  createdById       String?
  approvedById      String?

  amount          Decimal           @db.Decimal(18, 4)
  status          FundRequestStatus @default(PENDING)
  paymentMode     PaymentMode       @default(UPI)
  utrNumber       String            @unique
  receiptUrl      String?
  remarks         String?
  rejectionReason String?

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  merchantProfile MerchantProfile @relation(fields: [merchantProfileId], references: [id], onDelete: Restrict)
  createdBy       User?           @relation("AdminCreatedFundRequests", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy      User?           @relation("AdminFundApprovals", fields: [approvedById], references: [id], onDelete: Restrict)

  @@index([merchantProfileId, status])
  @@index([deletedAt])
  @@map("fund_requests")
}

// -----------------------------------------------------------------------------
// FRAUD, SECURITY & COMPLIANCE
// -----------------------------------------------------------------------------

model ApiKey {
  id                String      @id @default(cuid())
  merchantProfileId String
  createdById       String?
  environment       Environment @default(LIVE)
  name              String      @db.VarChar(50)
  keyPrefix         String      @db.VarChar(50)
  lastFour          String
  keyHash           String      @unique
  isActive          Boolean     @default(true)

  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  merchantProfile MerchantProfile @relation(fields: [merchantProfileId], references: [id], onDelete: Restrict)
  createdBy       User?           @relation("AdminCreatedApiKeys", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([merchantProfileId, isActive])
  @@index([deletedAt])
  @@map("api_keys")
}

model Blacklist {
  id                String        @id @default(cuid())
  merchantProfileId String?
  type              BlacklistType
  value             String        @unique
  reason            String?
  addedById         String

  merchantProfile MerchantProfile? @relation(fields: [merchantProfileId], references: [id], onDelete: Restrict)
  addedBy         User             @relation("AdminBlacklists", fields: [addedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([type, value])
  @@map("blacklists")
}

model SupportTicket {
  id                String         @id @default(cuid())
  merchantProfileId String
  subject           String
  status            TicketStatus   @default(OPEN)
  priority          TicketPriority @default(NORMAL)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  merchantProfile MerchantProfile  @relation(fields: [merchantProfileId], references: [id], onDelete: Restrict)
  messages        SupportMessage[]

  @@index([merchantProfileId, status])
  @@map("support_tickets")
}

model SupportMessage {
  id        String   @id @default(cuid())
  ticketId  String
  senderId  String
  isAdmin   Boolean  @default(false)
  message   String   @db.Text
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation("UserSupportMessages", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt(sort: Asc)])
  @@map("support_messages")
}

model SystemSetting {
  id              String   @id @default("GLOBAL_SETTINGS")
  upiPayoutFee    Decimal  @default(0.0000) @db.Decimal(18, 4)
  impsPayoutFee   Decimal  @default(0.0000) @db.Decimal(18, 4)
  neftPayoutFee   Decimal  @default(0.0000) @db.Decimal(18, 4)
  rtgsPayoutFee   Decimal  @default(0.0000) @db.Decimal(18, 4)
  taxPercentage   Decimal  @default(0.00) @db.Decimal(5, 2)
  minPayoutAmount Decimal  @default(100.0000) @db.Decimal(18, 4)
  maxPayoutAmount Decimal  @default(500000.0000) @db.Decimal(18, 4)
  updatedAt       DateTime @updatedAt
  updatedById     String?

  updatedBy User? @relation("AdminSettingsUpdates", fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model AuditLog {
  id         String         @id @default(cuid())
  actorType  AuditActorType
  actorId    String?
  entityType AuditEntity
  entityId   String
  action     AuditAction
  ipAddress  String?
  userAgent  String?
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([actorId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}
