# =============================================================================
# PAYERUPEE ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================

# Database Configuration (Neon / PostgreSQL)
# -----------------------------------------------------------------------------
# Pooled connection string for runtime queries (has '-pooler' in hostname)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled connection string for Prisma CLI migrations
DIRECT_URL="postgresql://user:password@ep-sample.aws.neon.tech/neondb?sslmode=require"

# Better Auth Configuration
# -----------------------------------------------------------------------------
# Secure random string of at least 32 characters
BETTER_AUTH_SECRET="replace_with_a_secure_random_string_of_at_least_32_characters"

# Base URL of the running application
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth 2.0 (Google Cloud Console)
# -----------------------------------------------------------------------------
# Create OAuth 2.0 Client ID (Web Application) in Google Cloud Console
# Authorized JavaScript Origin: http://localhost:3000
# Authorized Redirect URI: http://localhost:3000/api/v1/auth/callback/google
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Redis Configuration (For Caching & Rate Limiting)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# Application Environment
# -----------------------------------------------------------------------------
NODE_ENV="development"
