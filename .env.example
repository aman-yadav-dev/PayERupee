# =============================================================================
# PAYERUPEE ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================

# Database Configuration (Neon / PostgreSQL)
# -----------------------------------------------------------------------------
# Pooled connection string for runtime queries (has '-pooler' in hostname)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.aws.neon.tech/neondb?sslmode=require"

# Direct unpooled connection string for Prisma CLI migrations
DIRECT_URL="postgresql://user:password@ep-sample.aws.neon.tech/neondb?sslmode=require"

# Better Auth Configuration
# -----------------------------------------------------------------------------
# Secure random string of at least 32 characters
BETTER_AUTH_SECRET="replace_with_a_secure_random_string_of_at_least_32_characters"

# Base URL of the running application
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth 2.0 (Google Cloud Console)
# -----------------------------------------------------------------------------
# Create OAuth 2.0 Client ID (Web Application) in Google Cloud Console
# Authorized JavaScript Origin: http://localhost:3000
# Authorized Redirect URI: http://localhost:3000/api/v1/auth/callback/google
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# Redis Configuration (For Caching & Rate Limiting)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"

# Application Environment
# -----------------------------------------------------------------------------
NODE_ENV="development"

# Provider Configuration (Phase 6)
# -----------------------------------------------------------------------------
# Active payout provider (e.g., "CASHFREE", "MOCK")
PROVIDER_NAME="MOCK"

# Cashfree API Configuration (Phase 6)
# -----------------------------------------------------------------------------
CASHFREE_CLIENT_ID="your_cashfree_client_id"
CASHFREE_CLIENT_SECRET="your_cashfree_client_secret"
CASHFREE_WEBHOOK_SECRET="your_cashfree_webhook_secret"
CASHFREE_ENVIRONMENT="TEST" # TEST or PRODUCTION

# Ban User Subsystem Cryptographic Keys
# -----------------------------------------------------------------------------
# HMAC secret for blind indexing (minimum 32 characters, generate via `openssl rand -hex 32`)
BAN_HASH_SECRET="replace_with_a_secure_random_hmac_secret_at_least_32_chars"

# AES-256-GCM encryption key (64 hex characters / 32 bytes, generate via `openssl rand -hex 32`)
BAN_ENCRYPTION_KEY="replace_with_a_secure_64_character_hex_encryption_key"
